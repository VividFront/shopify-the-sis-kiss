{% doc %}
  @prompt
    Create a custom product badge block that can be added to product cards in collection and product listing pages. The badge should display custom text (e.g. "New", "Best Seller", "Limited Edition"), be configurable with custom background color, text color, and position (top left, top right, bottom left, bottom right), and support showing/hiding based on a product tag or metafield.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% liquid
  assign show_badge = false
  assign badge_text = block.settings.badge_text

  if block.settings.display_condition == 'always'
    assign show_badge = true
  elsif block.settings.display_condition == 'tag' and block.settings.product_tag != blank
    if product.tags contains block.settings.product_tag
      assign show_badge = true
    endif
  elsif block.settings.display_condition == 'metafield' and block.settings.metafield_namespace != blank and block.settings.metafield_key != blank
    assign metafield_value = product.metafields[block.settings.metafield_namespace][block.settings.metafield_key]
    if metafield_value != blank and metafield_value != false
      assign show_badge = true
      if block.settings.use_metafield_as_text and metafield_value != true
        assign badge_text = metafield_value
      endif
    endif
  endif
%}

{% if show_badge and badge_text != blank %}
  {% style %}
    .ai-product-badge-{{ ai_gen_id }} {
      display: block;
      position: absolute;
      z-index: 10;
      padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
      background-color: {{ block.settings.background_color }};
      color: {{ block.settings.text_color }};
      font-size: {{ block.settings.font_size }}px;
      font-weight: {{ block.settings.font_weight }};
      text-transform: {{ block.settings.text_transform }};
      border-radius: {{ block.settings.border_radius }}px;
      line-height: 1.2;
      white-space: nowrap;
      {% if block.settings.position == 'top-left' %}
        top: {{ block.settings.offset }}px;
        left: {{ block.settings.offset }}px;
      {% elsif block.settings.position == 'top-right' %}
        top: {{ block.settings.offset }}px;
        right: {{ block.settings.offset }}px;
      {% elsif block.settings.position == 'bottom-left' %}
        bottom: {{ block.settings.offset }}px;
        left: {{ block.settings.offset }}px;
      {% elsif block.settings.position == 'bottom-right' %}
        bottom: {{ block.settings.offset }}px;
        right: {{ block.settings.offset }}px;
      {% endif %}
      {% if block.settings.enable_shadow %}
        box-shadow: 0 2px 8px rgba(0, 0, 0, {{ block.settings.shadow_opacity }});
      {% endif %}
    }

    @media screen and (max-width: 749px) {
      .ai-product-badge-{{ ai_gen_id }} {
        font-size: {{ block.settings.font_size | times: 0.9 }}px;
        padding: {{ block.settings.padding_vertical | times: 0.8 }}px {{ block.settings.padding_horizontal | times: 0.8 }}px;
      }
    }
  {% endstyle %}

  <div class="ai-product-badge-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
    {{ badge_text }}
  </div>
{% endif %}

{% schema %}
{
  "name": "Product badge",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Badge content"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge text",
      "default": "New"
    },
    {
      "type": "select",
      "id": "display_condition",
      "label": "Display when",
      "options": [
        {
          "value": "always",
          "label": "Always show"
        },
        {
          "value": "tag",
          "label": "Product has tag"
        },
        {
          "value": "metafield",
          "label": "Product metafield exists"
        }
      ],
      "default": "always"
    },
    {
      "type": "text",
      "id": "product_tag",
      "label": "Product tag",
      "info": "Badge shows if product has this tag (e.g., 'new', 'bestseller')"
    },
    {
      "type": "text",
      "id": "metafield_namespace",
      "label": "Metafield namespace",
      "info": "e.g., 'custom'"
    },
    {
      "type": "text",
      "id": "metafield_key",
      "label": "Metafield key",
      "info": "e.g., 'badge'"
    },
    {
      "type": "checkbox",
      "id": "use_metafield_as_text",
      "label": "Use metafield value as badge text",
      "default": false,
      "info": "If enabled, the metafield value will replace the badge text above"
    },
    {
      "type": "header",
      "content": "Position"
    },
    {
      "type": "select",
      "id": "position",
      "label": "Badge position",
      "options": [
        {
          "value": "top-left",
          "label": "Top left"
        },
        {
          "value": "top-right",
          "label": "Top right"
        },
        {
          "value": "bottom-left",
          "label": "Bottom left"
        },
        {
          "value": "bottom-right",
          "label": "Bottom right"
        }
      ],
      "default": "top-left"
    },
    {
      "type": "range",
      "id": "offset",
      "label": "Offset from edge",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 10
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Font weight",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi-bold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "default": "600"
    },
    {
      "type": "select",
      "id": "text_transform",
      "label": "Text transform",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "uppercase",
          "label": "Uppercase"
        },
        {
          "value": "lowercase",
          "label": "Lowercase"
        },
        {
          "value": "capitalize",
          "label": "Capitalize"
        }
      ],
      "default": "uppercase"
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "label": "Horizontal padding",
      "min": 4,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "label": "Vertical padding",
      "min": 2,
      "max": 16,
      "step": 1,
      "unit": "px",
      "default": 4
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "enable_shadow",
      "label": "Enable shadow",
      "default": true
    },
    {
      "type": "range",
      "id": "shadow_opacity",
      "label": "Shadow opacity",
      "min": 0,
      "max": 1,
      "step": 0.1,
      "default": 0.2
    }
  ],
  "presets": [
    {
      "name": "Product badge"
    }
  ]
}
{% endschema %}